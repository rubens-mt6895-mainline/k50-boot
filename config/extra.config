# 额外内核配置片段（可选）
#
# 工作流在 k50-rubens_defconfig / stock_defconfig 之后把它合并进来
# （scripts/kconfig/merge_config.sh -m + olddefconfig）。
# 一行一个选项；想关掉某个用 "# CONFIG_FOO is not set"。
#
# 只写你确实需要的，写多了容易把能启动的配置改坏。
#
# --- 例子：让内核支持 zstd / xz 压缩的 squashfs（rootfs 仓的镜像模式用）---
# 默认的 k50-rubens_defconfig 只开了 gzip 压缩的 squashfs，所以 rootfs 仓
# 默认 squashfs_comp=gzip。如果你想吃 zstd 的挂载速度，这里打开下面两行，
# 再把 rootfs 仓的 config/config 里 squashfs_comp 改成 zstd。
#
# 实测（这台机器）：同一份 rootfs，gzip 1.94 GB / zstd 1.80 GB，只差约 7%，
# 所以不开也完全能用。
#
# CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_XZ=y
#
# --- 相机：MT6895 CAMSV 采集驱动 ---
# 这个驱动只存在于 k50-camera 分支（kernel_ref 覆盖成那个分支时才编得到）。
# 它是 tristate，编成 cam_cap.ko 后随 k50-modules-*.tar.gz 发给 rootfs 装。
# 换回别的 kernel_ref 时树里没有 VIDEO_MTK_CAMSV 这个符号，olddefconfig 会把
# 这一行丢掉，所以留着不影响其它分支的构建。
CONFIG_VIDEO_MTK_CAMSV=m
#
# --- 关掉 defconfig 里躺着的整批「别家 SoC」media 模块 ---
# k50-rubens_defconfig 是厂商 savedefconfig，media 下一大片 =m 是 imx/rcar/
# qcom/rockchip/samsung/sunxi 等别家平台的解码器、CSI 和 sensor。它们引用的
# 符号（scp_*、qcom_mdt_* 等）在 remoteproc/firmware 等本 CI 从不编的树里，
# M=drivers/media 一次 modpost 全点名就红。K50 只用 camsv + 软编，这些本来
# 就是 =m（不进 Image），统一关成 n，只留 mtk-jpeg 和 CAMSV。
# CONFIG_VIDEO_AMPHION_VPU is not set
# CONFIG_VIDEO_CADENCE_CSI2RX is not set
# CONFIG_VIDEO_WAVE_VPU is not set
# CONFIG_VIDEO_E5010_JPEG_ENC is not set
# CONFIG_VIDEO_IMX7_CSI is not set
# CONFIG_VIDEO_IMX_MIPI_CSIS is not set
# CONFIG_VIDEO_IMX8_ISI is not set
# CONFIG_VIDEO_IMX8_JPEG is not set
# CONFIG_VIDEO_QCOM_CAMSS is not set
# CONFIG_VIDEO_QCOM_IRIS is not set
# CONFIG_VIDEO_QCOM_VENUS is not set
# CONFIG_VIDEO_RCAR_CSI2 is not set
# CONFIG_VIDEO_RCAR_ISP is not set
# CONFIG_VIDEO_RCAR_VIN is not set
# CONFIG_VIDEO_RZG2L_CSI2 is not set
# CONFIG_VIDEO_RZG2L_CRU is not set
# CONFIG_VIDEO_RENESAS_FCP is not set
# CONFIG_VIDEO_RENESAS_FDP1 is not set
# CONFIG_VIDEO_RENESAS_VSP1 is not set
# CONFIG_VIDEO_RCAR_DRIF is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
# CONFIG_VIDEO_ROCKCHIP_CIF is not set
# CONFIG_VIDEO_SAMSUNG_EXYNOS_GSC is not set
# CONFIG_VIDEO_SAMSUNG_S5P_JPEG is not set
# CONFIG_VIDEO_SAMSUNG_S5P_MFC is not set
# CONFIG_VIDEO_SUN6I_CSI is not set
# CONFIG_VIDEO_SYNOPSYS_HDMIRX is not set
# CONFIG_VIDEO_TI_J721E_CSI2RX is not set
# CONFIG_VIDEO_HANTRO is not set
# CONFIG_VIDEO_IMX219 is not set
# CONFIG_VIDEO_IMX412 is not set
# CONFIG_VIDEO_OV5640 is not set
# CONFIG_VIDEO_OV5645 is not set
# CONFIG_VIDEO_S5KJN1 is not set
# CONFIG_VIDEO_MAX96712 is not set
# CONFIG_VIDEO_MESON_VDEC is not set
# CONFIG_VIDEO_MEDIATEK_VCODEC is not set
