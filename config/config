# ============================================================
#  k50-boot 构建配置
#  改这个文件 → push 到自己的 fork → Actions 自动重新构建
#  语法：key=value，一行一条，# 开头为注释，值不要加引号
# ============================================================

# ── 内核源码 ────────────────────────────────────────────────
# 上游仓库与分支/commit。也可以改成你自己的 fork（例如加了自己的补丁）
kernel_repo=https://github.com/rubens-mt6895-mainline/linux.git
kernel_ref=7.2-mt6895-xiaomi-rubens

# ── 产物版本后缀 ────────────────────────────────────────────
# 会拼进内核版本号与 vermagic，用来区分 CI 产物。
# 想沿用设备 /root 下现成的 .ko（相机 / 指纹 / 基带）时，把它留空并保证
# 内核源码与那些 .ko 的构建源码完全一致，否则 vermagic 对不上加载不了。
localversion=-k50-ci

# ── 内核配置来源 ─────────────────────────────────────────────
# auto  = config/stock_defconfig 存在就用它，否则用仓库自带的 k50-rubens_defconfig
# repo  = 只用 k50-rubens_defconfig
# stock = 只用 config/stock_defconfig（不存在则构建失败）
config_source=auto

# ── 外部内核模块 ─────────────────────────────────────────────
# 逗号分隔，留空 = 不编。仓库自带：k50-bl（面板背光 → /sys/class/backlight/l11a）
modules=k50-bl

# ── 可选补丁 ────────────────────────────────────────────────
# patches/optional/ 下的补丁默认不打（那个是电源键 release 去抖，非必需）
optional_patches=false

# ── 调试信息 ────────────────────────────────────────────────
# 只影响编译时间/磁盘大小？**不是**。实测（同一源码、同一工具链）：
#   关掉 DEBUG_INFO → Image 内容有 24,251,244 字节不同，gzip(-9) 从 19,932,644
#                     涨到 20,097,258 字节（+164,614）
#   厂商内核段上限是 19,945,390 字节 → **关掉后 boot.img 直接塞不进去**（打包失败）
# 所以默认 false：要出 boot.img 就别关。true 只适合"只要内核产物、不打包"的场景。
# false = 保留调试信息（默认，且必须；vmlinux 约 569 MB）
# true  = 关掉 DEBUG_INFO（vmlinux 约 71 MB、编得快，但 gzip 反而大 164 KB）
trim_debug_info=false

# ── boot.img 打包 ───────────────────────────────────────────
# auto = base/boot.img 或 base_url 有就用它打包；yes = 必须打包（拿不到就失败）；no = 只出内核产物
pack_boot=auto

# ── Release ────────────────────────────────────────────────
# ci-* 标签的 Release 保留几个（更旧的自动删除，省配额）
keep_releases=10
