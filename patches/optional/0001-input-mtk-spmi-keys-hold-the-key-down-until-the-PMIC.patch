From 27c7c2c98c85c3452beec8c6ff02a15bdeccdc3c Mon Sep 17 00:00:00 2001
From: gddhd059 <gddhd059@users.noreply.github.com>
Date: Fri, 30 Oct 2026 23:27:56 +0800
Subject: [PATCH] input: mtk-spmi-keys: hold the key down until the PMIC stops
 reporting it

The MT6363 TOPSTATUS PWRKEY/HOMEKEY bits are cleared by the PMIC when the
key is released, but the 30 ms poll sees the bit drop about 185 ms early,
so a held power key showed up as a ~185 ms pulse and every consumer of the
event stream (long-press detection in particular) saw the key already up.

Remember the last time the raw bit was seen, keep the logical key pressed
for MTK_KEYS_RELEASE_GRACE_MS (400 ms) after that, and log the down/up
transitions so a press can be followed at runtime.
---
 drivers/input/misc/mtk-spmi-keys.c | 32 ++++++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/drivers/input/misc/mtk-spmi-keys.c b/drivers/input/misc/mtk-spmi-keys.c
index b52908c6f518..765d0b05876a 100644
--- a/drivers/input/misc/mtk-spmi-keys.c
+++ b/drivers/input/misc/mtk-spmi-keys.c
@@ -26,6 +26,7 @@
  */
 
 #include <linux/input.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -35,6 +36,13 @@
 
 #define MTK_KEYS_MAX		2
 #define MTK_KEYS_POLL_MS	30
+/*
+ * MT6363 TOPSTATUS PWRKEY/HOMEKEY bits are auto-cleared by the PMIC
+ * shortly after the key is released, so a pure 30 ms poll sees a
+ * ~185 ms pulse even while the key is still held.  Keep the key
+ * logically pressed until we have gone this long without seeing it.
+ */
+#define MTK_KEYS_RELEASE_GRACE_MS	400
 
 static const struct regmap_config mtk_keys_regmap_config = {
 	.reg_bits	= 16,
@@ -57,6 +65,7 @@ struct mtk_keys {
 	struct mtk_keys_info keys[MTK_KEYS_MAX];
 	int num_keys;
 	bool key_pressed[MTK_KEYS_MAX];
+	unsigned long last_press[MTK_KEYS_MAX];
 	u32 last_status;
 };
 
@@ -79,11 +88,30 @@ static void mtk_keys_work(struct work_struct *work)
 	}
 
 	for (i = 0; i < keys->num_keys; i++) {
-		bool pressed;
+		bool raw_pressed, pressed;
+
+		raw_pressed = !(status & keys->keys[i].deb_mask);
+
+		if (raw_pressed) {
+			/* Remember when we last saw the key down. */
+			keys->last_press[i] = jiffies;
+			pressed = true;
+		} else {
+			/*
+			 * The PMIC clears the status bit ~185 ms after the
+			 * physical release, so hold the logical press for a
+			 * grace period before reporting the release.
+			 */
+			pressed = keys->key_pressed[i] &&
+				  time_before(jiffies,
+					      keys->last_press[i] +
+					      msecs_to_jiffies(MTK_KEYS_RELEASE_GRACE_MS));
+		}
 
-		pressed = !(status & keys->keys[i].deb_mask);
 		if (pressed != keys->key_pressed[i]) {
 			keys->key_pressed[i] = pressed;
+			dev_info(keys->dev, "key %d (%s)\n", i,
+				 pressed ? "down" : "up");
 			input_report_key(keys->input_dev,
 					 keys->keys[i].keycode, pressed);
 			input_sync(keys->input_dev);
-- 
