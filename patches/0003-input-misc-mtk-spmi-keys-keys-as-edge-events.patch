 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -35,6 +36,18 @@
 
 #define MTK_KEYS_MAX		2
 #define MTK_KEYS_POLL_MS	30
+/* 诊断用：每 MTK_KEYS_SCAN_EVERY 次轮询扫一遍 PMIC 寄存器窗口，
+ * 任何寄存器变化都打进 dmesg，用来定位按键到底落在哪个寄存器。 */
+#define MTK_KEYS_SCAN_BASE	0x00
+#define MTK_KEYS_SCAN_REGS	0x40
+#define MTK_KEYS_SCAN_EVERY	5
+/*
+ * TOPSTATUS 的按键位是自清零/粘滞的：边沿之后约 185 ms 可能被 PMIC 自己
+ * 清掉（按着也清），也可能一直粘着不落。所以既不能把电平当"按住"，
+ * 也不能每读到一次置起就报一次（那样会 5 Hz 刷点击）。
+ * 这里用"锁定边沿 + 落下后至少稳定这么久才算新的一次点击"。
+ */
+#define MTK_KEYS_EDGE_GUARD_MS	300
 
 static const struct regmap_config mtk_keys_regmap_config = {
 	.reg_bits	= 16,
@@ -45,6 +58,8 @@ static const struct regmap_config mtk_keys_regmap_config = {
 struct mtk_keys_info {
 	unsigned int keycode;
 	u32 deb_mask;
+	/* 极性不再写死：probe 时按"空闲时这一位是什么"推出来 */
+	bool active_low;
 	unsigned int deb_reg;
 	bool wakeup;
 };
@@ -56,10 +71,45 @@ struct mtk_keys {
 	struct delayed_work poll_work;
 	struct mtk_keys_info keys[MTK_KEYS_MAX];
 	int num_keys;
-	bool key_pressed[MTK_KEYS_MAX];
+	/* 边沿锁定：raw 为真且上一次为假才算一次点击，按住不会重复上报 */
+	bool latched[MTK_KEYS_MAX];
+	/* 位落下去的稳定时刻，用来给下一次点击做守卫 */
+	unsigned long last_clear[MTK_KEYS_MAX];
 	u32 last_status;
+	u32 idle_status;
+	u8 shadow[MTK_KEYS_SCAN_REGS];
+	unsigned int scan_tick;
 };
 
+static void mtk_keys_scan(struct mtk_keys *keys)
+{
+	u8 now[MTK_KEYS_SCAN_REGS];
+	unsigned int reg, v;
+	int i, changed = 0;
+
+	for (i = 0; i < MTK_KEYS_SCAN_REGS; i++) {
+		reg = MTK_KEYS_SCAN_BASE + i;
+		if (regmap_read(keys->regmap, reg, &v))
+			now[i] = keys->shadow[i];
+		else
+			now[i] = v & 0xff;
+	}
+
+	for (i = 0; i < MTK_KEYS_SCAN_REGS; i++) {
+		if (now[i] != keys->shadow[i]) {
+			dev_info(keys->dev, "PMIC 0x%02x: 0x%02x -> 0x%02x
+",
+				 MTK_KEYS_SCAN_BASE + i, keys->shadow[i], now[i]);
+			keys->shadow[i] = now[i];
+			changed++;
+		}
+	}
+
+	if (changed)
+		dev_info(keys->dev, "PMIC scan: %d register(s) changed
+", changed);
+}
+
 static void mtk_keys_work(struct work_struct *work)
 {
 	struct mtk_keys *keys = container_of(work, struct mtk_keys,
@@ -67,6 +117,9 @@ static void mtk_keys_work(struct work_struct *work)
 	u32 status;
 	int i, ret;
 
+	if (!(keys->scan_tick++ % MTK_KEYS_SCAN_EVERY))
+		mtk_keys_scan(keys);
+
 	ret = regmap_read(keys->regmap, keys->keys[0].deb_reg, &status);
 	if (ret) {
 		dev_err(keys->dev, "failed to read key status: %d\n", ret);
@@ -78,16 +131,45 @@ static void mtk_keys_work(struct work_struct *work)
 		keys->last_status = status;
 	}
 
+	if (status != keys->last_status) {
+		dev_info(keys->dev, "status 0x%02x -> 0x%02x (idle 0x%02x)\n",
+			 keys->last_status, status, keys->idle_status);
+		keys->last_status = status;
+	}
+
 	for (i = 0; i < keys->num_keys; i++) {
-		bool pressed;
-
-		pressed = !(status & keys->keys[i].deb_mask);
-		if (pressed != keys->key_pressed[i]) {
-			keys->key_pressed[i] = pressed;
-			input_report_key(keys->input_dev,
-					 keys->keys[i].keycode, pressed);
-			input_sync(keys->input_dev);
+		bool raw;
+
+		/* active_low 由 probe 时的空闲电平决定，不再假定 */
+		raw = keys->keys[i].active_low
+			? !(status & keys->keys[i].deb_mask)
+			: !!(status & keys->keys[i].deb_mask);
+
+		if (!raw) {
+			/* 落下：从这个时刻起算守卫 */
+			keys->last_clear[i] = jiffies;
+			keys->latched[i] = false;
+			continue;
 		}
+
+		if (keys->latched[i])
+			continue;	/* 还咬着，不重复上报 */
+
+		/* 刚落下来就又被置起（自清零抖动）视为同一次点击 */
+		if (keys->last_clear[i] &&
+		    time_before(jiffies, keys->last_clear[i] +
+				msecs_to_jiffies(MTK_KEYS_EDGE_GUARD_MS))) {
+			keys->latched[i] = true;
+			continue;
+		}
+
+		keys->latched[i] = true;
+		dev_info(keys->dev, "key %d (code %u) click, status 0x%02x\n",
+			 i, keys->keys[i].keycode, status);
+		input_report_key(keys->input_dev, keys->keys[i].keycode, 1);
+		input_sync(keys->input_dev);
+		input_report_key(keys->input_dev, keys->keys[i].keycode, 0);
+		input_sync(keys->input_dev);
 	}
 
 reschedule:
@@ -100,8 +182,15 @@ static int mtk_keys_parse(struct mtk_keys *keys)
 	struct device *dev = keys->dev;
 	struct device_node *keys_np, *child;
 	struct mtk_keys_info *info;
+	u32 idle = 0;
 	int i = 0;
 
+	/* 空闲基线：开机后、任何人碰按键之前读到的 TOPSTATUS。 */
+	if (!regmap_read(keys->regmap, MT6363_REG_TOPSTATUS, &idle))
+		keys->idle_status = idle;
+	else
+		dev_warn(dev, "读不到空闲 TOPSTATUS，极性只能按缺省判\n");
+
 	/* As an MFD child, dev->of_node IS the "mediatek,mt6363-keys" node. */
 	keys_np = of_node_get(dev->of_node);
 	if (!keys_np) {
@@ -128,6 +217,17 @@ static int mtk_keys_parse(struct mtk_keys *keys)
 		 * The stock rubens DT's child order is power then home. */
 		info->deb_reg = MT6363_REG_TOPSTATUS;
 		info->deb_mask = (i == 0) ? BIT(1) : BIT(3);
+		/*
+		 * 极性不写死：以"开机后没人碰按键时的这一位"作为空闲电平，
+		 * 空闲为 0 => 按下置 1（active-high）；空闲为 1 => 按下拉 0。
+		 * 真机上 PWRKEY/HOMEKEY 的空闲基线在不同启动里并不一致，
+		 * 写死 active_low 正是上一版把电源键判死、把音量上判成常按的原因。
+		 */
+		info->active_low = !!(keys->idle_status & info->deb_mask);
+		dev_info(keys->dev, "key %d: code %u mask 0x%02x idle 0x%02x -> %s\n",
+			 i, info->keycode, info->deb_mask,
+			 keys->idle_status,
+			 info->active_low ? "active-low" : "active-high");
 		info->wakeup = of_property_read_bool(child, "wakeup-source");
 		i++;
 	}
