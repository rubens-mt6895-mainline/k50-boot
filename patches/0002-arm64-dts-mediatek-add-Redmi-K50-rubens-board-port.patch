-	status = "okay";
-	dr_mode = "otg";
-	usb-role-switch;
-	/*
-	 * port/rubens-clean uses "device", not "peripheral", and sets the same
-	 * value on the xHCI node below.  Their OTG host mode is known to work,
-	 * so follow them rather than our own guess.
